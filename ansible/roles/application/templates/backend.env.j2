NODE_ENV=production
PORT={{ mern_backend_port }}
HOST=127.0.0.1
MONGODB_URI=mongodb://{{ mern_mongodb_user | urlencode }}:{{ mern_mongodb_password | urlencode }}@127.0.0.1:27017/{{ mern_mongodb_database }}?authSource={{ mern_mongodb_database }}
MONGODB_DB={{ mern_mongodb_database }}
JWT_SECRET={{ mern_jwt_secret }}
JWT_EXPIRES_IN=1h
CLIENT_ORIGIN={{ 'http://localhost' if mern_local_only else 'http://' ~ mern_domain }}
# This bundled Nginx site is HTTP-only; browsers reject Secure cookies over HTTP.
REFRESH_COOKIE_SECURE=false
ADMIN_NAME={{ mern_admin_name | to_json }}
ADMIN_EMAIL={{ mern_admin_email | to_json }}
ADMIN_PASSWORD={{ mern_admin_password | to_json }}
