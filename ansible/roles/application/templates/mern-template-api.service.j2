[Unit]
Description=MERN Template API
After=network-online.target mongod.service
Wants=network-online.target

[Service]
Type=simple
User={{ mern_app_user }}
Group={{ mern_app_user }}
WorkingDirectory={{ mern_app_directory }}/backend
EnvironmentFile={{ mern_app_directory }}/backend/.env
ExecStart=/usr/bin/npm start
Restart=on-failure
RestartSec=5s
TimeoutStopSec=30s
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
