NODE_ENV=development
PORT=5000
HOST=127.0.0.1
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=mern_template
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=15m
REFRESH_EXPIRES_SECONDS=2592000
REFRESH_COOKIE_NAME=refresh_session
# Defaults to true only when every CLIENT_ORIGIN uses HTTPS. Normally override
# this only when TLS termination makes the browser-facing protocol differ.
# REFRESH_COOKIE_SECURE=true
INVITATION_EXPIRES_SECONDS=604800
VERIFICATION_EXPIRES_SECONDS=86400
RESET_EXPIRES_SECONDS=3600
# Development-only: return account-action links in API responses.
EXPOSE_ACCOUNT_TOKENS=false
# Set these to require invitation acceptance to record explicit consent.
TERMS_VERSION=
PRIVACY_VERSION=
CLIENT_ORIGIN=http://localhost:3000
ADMIN_NAME=Administrator
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-admin-password
